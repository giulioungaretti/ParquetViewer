<Window
    x:Class="LOBapp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
                  Title="Parquet Viewer"
                  Subtitle="{x:Bind ViewModel.FilePath, Mode=OneWay}">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                  ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        <CommandBar Grid.Row="1"
                    Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Left" Opacity="1">
            <AppBarButton Icon="OpenFile" Label="Open" Command="{x:Bind ViewModel.OpenFileCommand}" >
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Clear" Label="Close" Command="{x:Bind ViewModel.CloseCommand}" >
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Q" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>
        <ContentControl x:Name="Body" Grid.Row="2" Margin="5,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.IsNotDoingIO, Mode=OneWay}" />
        <ProgressRing IsActive="{x:Bind ViewModel.IsDoingIO, Mode=OneWay}" Grid.Row="2"
                      IsHitTestVisible="False" AutomationProperties.Name="Loading Parquet file" />
        <InfoBar
        IsOpen="{x:Bind ViewModel.InfoBarOpen, Mode=TwoWay}"
        Severity="{x:Bind ViewModel.InfoBarSev, Mode=OneWay}"
        Message="{x:Bind ViewModel.InfoBarMsg, Mode=OneWay}"
        Grid.Row="3"
        Margin="5"
         />
    </Grid>

</Window>
